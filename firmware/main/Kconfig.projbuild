menu "pocket-tank"
    config POCKET_TANK_BOARD_LCD169
        bool "Board: Waveshare ESP32-S3-(Touch-)LCD-1.69 (ST7789 240x280) instead of the AMOLED-1.8"
        default n
        help
            Drives the 1.69in LCD board: ST7789V2 over SPI (the tank scaled to 280x240),
            CST816T touch, battery by ADC, the PWR key on SYS_OUT / SYS_EN. The ES8311
            audio port cannot be used on this board (its I2S pins are the LCD's).
            Build with: idf.py -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.lcd169" build
    config POCKET_TANK_BOARD_ES3C28P
        bool "Board: Hosyond / LCDWIKI ESP32-S3 2.8in (ES3C28P: ILI9341V 240x320 + FT6336G) instead of the AMOLED-1.8"
        default n
        help
            Drives the 2.8in LCD board: ILI9341V over SPI (the tank scaled to 320x240, landscape),
            FT6336G touch, battery by ADC (no PMIC, no IMU, no RTC), ES8311 audio on its own I2S pins.
            Choose at most one of the BOARD_* options.
            Build with: idf.py -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.es3c28p" build
    config POCKET_TANK_ES3C28P_FLIP
        bool "ES3C28P: turn the picture 180 degrees (USB-C on the other side)"
        depends on POCKET_TANK_BOARD_ES3C28P
        default n
        help
            The board has no IMU to pick the upright side, so which edge is the bottom is a build
            choice. Touch follows.
    config POCKET_TANK_PRESENCE_VL53L1X
        bool "ES3C28P: the screen follows a VL53L1X time-of-flight sensor on the I2C header"
        depends on POCKET_TANK_BOARD_ES3C28P
        default n
        help
            A VL53L1X on the 4-pin I2C header (3V3, GND, SCL = GPIO15, SDA = GPIO16; XSHUT on GPIO14 if
            wired) lights the screen when somebody is near and darkens it after they leave. The tank keeps
            running with the screen dark. No sensor, or one that stops answering: the screen stays on.
            Needs ESP-IDF 5.5.2 or newer (the sensor driver component).
    config POCKET_TANK_PRESENCE_NEAR_MM
        int "Presence: near distance (mm)"
        depends on POCKET_TANK_PRESENCE_VL53L1X
        range 100 1300
        default 600
    config POCKET_TANK_PRESENCE_HOLD_S
        int "Presence: seconds the screen stays on after the last sign of anyone (a reading, a touch, BOOT)"
        depends on POCKET_TANK_PRESENCE_VL53L1X
        range 3 600
        default 20
    config POCKET_TANK_PRESENCE_BATTERY_PERIOD_S
        int "Presence: seconds between readings on battery with the screen off"
        depends on POCKET_TANK_PRESENCE_VL53L1X
        range 1 600
        default 5
        help
            A reading takes ~21 ms (measured; up to ~65 ms) at ~18 mA, about 0.4 mC, so 5 s averages
            ~0.08 mA and 60 s ~0.007 mA, against the tank's own 70-100 mA awake: the interval sets how
            soon a visitor lights the screen, not the battery life.
    config POCKET_TANK_PRESENCE_USB_PERIOD_MS
        int "Presence: milliseconds between readings on USB (and while the screen is on)"
        depends on POCKET_TANK_PRESENCE_VL53L1X
        range 100 5000
        default 500
    config POCKET_TANK_DISPLAY_SH8601
        bool "Drive the Waveshare 1.8in AMOLED (SH8601 / CO5300 over QSPI)"
        default n
        help
            Enable for the real board. Off = stub display port (QEMU / compile-only).
    config POCKET_TANK_TOUCH_FT3168
        bool "Read the FT3168 capacitive touch (taps / holds)"
        default n
    config POCKET_TANK_AUDIO_ES8311
        bool "Play the sound bank through the ES8311 codec + NS4150B amp (I2S)"
        default n
        help
            Enable for the real board (docs/AUDIO.md). Off = stub audio port: cues compile, nothing plays.
    config POCKET_TANK_CUTOFF_MV
        int "Low-voltage cutoff for a board with no PMIC (mV; 0 = off)"
        range 0 3600
        default 0
        help
            On the cell (not on a cable) and under this voltage for 30 s in a row, the tank saves and goes
            into deep sleep so the cell is not drained flat (BOOT or RESET wakes it). Only for a board whose
            battery port has no PMIC to do it (the ES3C28P); a PMIC board (the AMOLED's AXP2101) is left alone.
            A good Li-ion cell is about empty at 3.3 V resting; 0 leaves it off.
    config POCKET_TANK_NO_PIE
        bool "Disable the PIE SIMD inference kernel (scalar dot products)"
        default n
        help
            Enable for a QEMU build if the emulator lacks ESP32-S3 PIE support.
endmenu
