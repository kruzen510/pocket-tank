# Hosyond / LCDWIKI ESP32-S3 2.8in (ES3C28P) overlay - layered on sdkconfig.defaults:
#   idf.py -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.es3c28p" build
# (delete any old sdkconfig / build dir first so these take effect)
# The module is an ESP32-S3-WROOM-1 N16R8: 16 MB quad flash + 8 MB octal PSRAM, the same
# memory the base defaults assume, so nothing here touches flash or PSRAM.
CONFIG_POCKET_TANK_BOARD_ES3C28P=y
CONFIG_POCKET_TANK_DISPLAY_SH8601=n
CONFIG_POCKET_TANK_TOUCH_FT3168=y
CONFIG_POCKET_TANK_AUDIO_ES8311=y
# the screen follows a VL53L1X on the I2C header; with no sensor fitted the screen simply stays on
CONFIG_POCKET_TANK_PRESENCE_VL53L1X=y
# the screen stays on 30 s after the last sign of anyone (was 20; the Kconfig default stays 20)
CONFIG_POCKET_TANK_PRESENCE_HOLD_S=30
# and lights for anyone within 1000 mm (was 600; the Kconfig default stays 600)
CONFIG_POCKET_TANK_PRESENCE_NEAR_MM=1000
# no PMIC here: under 3.3 V on the cell for 30 s the tank saves and deep sleeps, so the cell is not drained flat
CONFIG_POCKET_TANK_CUTOFF_MV=3300
